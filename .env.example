# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# AI Providers
# ============================================================================
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=AIza...

FLASHCARDS_PROVIDER=groq
FLASHCARDS_OPENAI_PERCENT=0
FLASHCARDS_OPENAI_MODEL=gpt-4o-mini
OPENAI_FLASHCARDS_MODEL=gpt-4o-mini
OPENAI_FLASHCARDS_FALLBACK_MODEL=gpt-5-mini
OPENAI_QUESTOES_MODEL=gpt-4.1-mini
OPENAI_FLASHCARD_MAX_CONCURRENT=8
OPENAI_QUESTOES_MAX_CONCURRENT=2
OPENAI_PROMPT_CACHE_RETENTION=in_memory
FLASHCARDS_GROQ_MAX_CHUNKS=3
FLASHCARDS_GROQ_MAX_CHARS_TOTAL=4200
FLASHCARDS_GROQ_MAX_CHARS_PER_CHUNK=900
FLASHCARDS_GEMINI_MAX_CHUNKS=3
FLASHCARDS_GEMINI_MAX_CHARS_TOTAL=4800
FLASHCARDS_GEMINI_MAX_CHARS_PER_CHUNK=950
FLASHCARDS_OPENAI_MAX_CHUNKS=2
FLASHCARDS_OPENAI_MAX_CHARS_TOTAL=2800
FLASHCARDS_OPENAI_MAX_CHARS_PER_CHUNK=750
QUESTOES_OPENAI_MAX_CHUNKS=6
QUESTOES_OPENAI_MAX_CHARS_TOTAL=18000
QUESTOES_OPENAI_MAX_CHARS_PER_CHUNK=2200
QUESTOES_MAX_OUTPUT_TOKENS=0
QUESTOES_AI_TIMEOUT_MS=120000
MAX_QUESTIONS_PER_GENERATION_CALL=8
SOURCE_DIGEST_ENABLED=true
SOURCE_DIGEST_PROVIDER=openai
SOURCE_DIGEST_MODEL=gpt-4o-mini
SOURCE_DIGEST_VERSION=v1
SOURCE_DIGEST_MAX_CHUNKS=12
SOURCE_DIGEST_MAX_CHARS=14000
SOURCE_DIGEST_MAX_CHARS_PER_CHUNK=1300
SOURCE_DIGEST_TARGET_FACTS=16
SOURCE_DIGEST_MAX_OUTPUT_TOKENS=1400

# ============================================================================
# Public Launch Quotas
# ============================================================================
# Defaults in code: Free users get 5 flashcard generations/month and no simulados.
# Pro defaults are effectively unlimited; lower these if you need an emergency cap.
FREE_TRIAL_DAYS=30
FREE_FLASHCARD_RUNS_PER_MONTH=5
FREE_SIMULADO_RUNS_PER_MONTH=0
PRO_FLASHCARD_RUNS_PER_MONTH=999999
PRO_SIMULADO_RUNS_PER_MONTH=999999

# ============================================================================
# Stripe Billing
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
# Live production: use sk_live_/rk_live_, the live price ID, and the signing
# secret from https://www.vimens.com.br/api/stripe/webhook. Before deploying,
# run: npm run stripe:production:preflight
# Production must use the real public origin, e.g. https://www.vimens.com.br.
# Auth confirmation emails and server-generated links use this value.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Internal Secrets
# ============================================================================

# Segredo dedicado para autenticar chamadas internas ao /api/runs/process.
# OBRIGATORIO — o sistema falha se nao estiver definido.
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RUNS_PROCESS_INTERNAL_SECRET=

# QStash signing keys para autenticar schedules que chamam /api/cron/*.
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Token usado apenas pelo preflight local para conferir se os schedules existem.
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=

# Fallback legado durante a migracao de Vercel Cron -> QStash.
# Remova apos confirmar que todos os schedules do QStash estao ativos.
CRON_SECRET=

# ============================================================================
# Admin
# ============================================================================
SECURITY_ALERT_EMAIL=

# ============================================================================
# Private Beta
# ============================================================================
BETA_INVITE_LIMIT=30
BETA_TRIAL_DAYS=30
BETA_CODE_TTL_DAYS=14
BETA_INVITE_CODE_SECRET=

# ============================================================================
# Upstash Redis (rate limiting / circuit breaker)
# ============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================================
# Observability (optional)
# ============================================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ============================================================================
# E2E / Dev-only
# ============================================================================
BILLING_E2E_SECRET=
BILLING_E2E_ENABLED=false
BILLING_CHECKOUT_E2E_ENABLED=false
BILLING_APP_ROUTE_E2E_ENABLED=false
BILLING_E2E_APP_URL=http://localhost:3000
BILLING_E2E_ARTIFACT_DIR=artifacts/billing
# For deployed staging validation on non-Vercel hosts. Vercel preview deploys can rely on VERCEL_ENV=preview.
APP_ENV=local
WEBHOOK_ALERT_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NEXT_RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL="Vimens <noreply@vimens.com.br>"
